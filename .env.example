# GitHub OAuth App (create at https://github.com/settings/developers)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Random long string used to AES-GCM encrypt the GitHub token stored in the
# httpOnly session cookie. Generate a fresh one, e.g.:
#   openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# Vercel Postgres (added automatically when you attach Postgres storage on Vercel)
POSTGRES_URL=

# Set automatically at build time by `npm run build` (scripts/set-build-id.js).
# You do not need to set this yourself.
NEXT_PUBLIC_BUILD_ID=
