# GitHub OAuth App (create at https://github.com/settings/developers)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET= 

# Vercel Integration (create at https://vercel.com/dashboard/integrations/console
# — "Create Integration". This is a different system from "Sign in with
# Vercel"/Team Settings > Apps; that one won't work here).
# After creating it, the Redirect URL in its settings must be:
#   https://<your-domain>/api/auth/vercel/callback
# VERCEL_INTEGRATION_SLUG is the "URL Slug" you set on the integration
# (vercel.com/integrations/<slug>) — used to start the install flow.
# VERCEL_OAUTH_CLIENT_ID / _SECRET come from the integration's Credentials
# tab, used only for the server-side code-for-token exchange.
VERCEL_INTEGRATION_SLUG= 
VERCEL_OAUTH_CLIENT_ID=
VERCEL_OAUTH_CLIENT_SECRET=

# Random long string used to AES-GCM encrypt the GitHub token stored in the
# httpOnly session cookie. Generate a fresh one, e.g.:
#   openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# Vercel Postgres (added automatically when you attach Postgres storage on Vercel)
POSTGRES_URL=

# Vercel Blob (added automatically when you attach Blob storage on Vercel).
# Used to stage uploaded ZIPs during analyze/push so they never have to pass
# through the ~4.5MB serverless function body limit. See lib/blob-fetch.ts
# and components/UploadZone.tsx.
BLOB_READ_WRITE_TOKEN=

# Set automatically at build time by `npm run build` (scripts/set-build-id.js).
# You do not need to set this yourself.
NEXT_PUBLIC_BUILD_ID=

# The production origin HARBOR CARGO is served from (no trailing slash), e.g.
#   NEXT_PUBLIC_SITE_URL=https://harbor-cargo.vercel.app
# Used for metadataBase, canonical URLs, Open Graph, sitemap.xml, and
# robots.txt. Falls back to the production domain if unset so metadata never
# resolves to localhost.
NEXT_PUBLIC_SITE_URL=https://harbor-cargo.vercel.app
